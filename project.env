# DEFAULT ENVIRONMENT VARIABLES FOR FLYWAY AND POSTGRESQL
# update these values as needed for your specific environment
FLYWAY_USER=postgres
FLYWAY_PASSWORD=password
FLYWAY_URL=jdbc:postgresql://database:5432/postgres

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres

PGUSER=postgres
PGPASSWORD=password
PGDATABASE=postgres
PGHOST=database
PGPORT=5432

# Shared Hugging Face cache path used by the loader/query containers (override on Windows/macOS as needed)
HF_CACHE_PATH=~/.cache/huggingface
