# Example environment variable file for QueryBooks. Copy this to .env and fill in the values as needed.

# main models – the loader/chat stack defaults to OpenAI unless you explicitly switch providers
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_RERANK_MODEL=gpt-4o-mini

# (OPTIONAL) Azure OpenAI settings (discouraged, see README for details)
AZURE_ENDPOINT=<foundry-your-endpoint>.cognitiveservices.azure.com/
AZURE_API_KEY=
AZURE_API_VERSION=2025-03-01-preview  # 2025-03-01-preview # 2025-01-01-preview

# FOR EMBEDDINGS, OpenAI is the default; set MEDIUM_PROVIDER=azure to run the medium step through Azure.
HF_TOKEN=
MEDIUM_PROVIDER=openai

# Keep aligned with knowledge_base_mini vector dim (384); do not change casually.
DEPLOY_MINI=sentence-transformers/all-MiniLM-L6-v2 # local option
DEPLOY_SMALL=BAAI/bge-large-en-v1.5 # 2nd local option
DEPLOY_MEDIUM=text-embedding-ada-002 # OpenAI's embedding model; if using Azure, set MEDIUM_PROVIDER=azure.

# Database settings used by the apps (containers may override their own values).
PGHOST=localhost
PGPORT=5431 # default Postgres port is 5432, but using 5431 here to avoid conflicts with any local Postgres instances
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=password
PGSSLMODE=disable

# Semantic chunking uses embeddings to determine chunk boundaries,
# but this does not necessarily mean that the chunking model
# and the embedding model need to be the same.
# Small models can be used for chunking to save cost/compute/time.
CHUNKER=semantic
#CHUNKER=spacy # relies on linguistic features rather than embedding distances
CHUNKING_PROVIDER=local # or "azure" (this is discouraged, see README for details)
CHUNKING_LOCAL_MODEL=sentence-transformers/all-MiniLM-L6-v2
BREAKPOINT_THRESHOLD_TYPE=percentile # not relevant when using spacy chunking
MAX_SENTENCES=5 # not relevant  when using semantic chunking
MAX_EMBED_TOKENS=2000 # depends on the embedding model's max input size
SPLIT_OVERLAP_TOKENS=80

MAX_MEMORY_TOKENS=8000 # message history tokens to keep in memory; adjust based on context window and expected conversation length

